# Copy to .env.local and fill in. Never commit .env.local (see .gitignore).

# --- Ragic (handover §4) --------------------------------------------------
# Fill in only after Step 0 (curl the sheet, write ragic-schema.md, fill in
# lib/ragic-fields.ts). Server-side only — never sent to the browser.
RAGIC_BASE_URL=https://ap7.ragic.com
RAGIC_SHEET_PATH=FCIGroup/dd-probation/2
RAGIC_API_KEY=

# Set to 1 to develop against the real 466-record prototype dataset instead
# of live Ragic (lib/get-records.ts). Never set this in production.
USE_FIXTURE_DATA=1

# --- Password gate (handover §15) -----------------------------------------
# SITE_PASSWORD is the shared password everyone uses to sign in.
# SESSION_SECRET signs the session cookie — a long random value, unrelated
# to the password. Generate one with: openssl rand -base64 32
SITE_PASSWORD=
SESSION_SECRET=

# --- Cron / revalidate (handover §3, §18) ----------------------------------
# Checked against the "x-cron-secret" header on POST /api/cron/revalidate.
# An external n8n workflow calls this every 5 minutes — see the README for
# the exact URL, method and header to configure there.
CRON_SECRET=
